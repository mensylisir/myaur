# makepkg build products
pkg/
src/
*.pkg.tar.zst
*.pkg.tar.xz
*.pkg.tar.gz
*.pkg.tar.bz2
*.pkg.tar.lz4

# downloaded upstream archives must never be committed
*.part
*.dmg
*.exe
/catpaw/*innoextract-linux-amd64
/catpaw-cn/*innoextract-linux-amd64
/catpaw-cn/*.zip
/catpaw-cn/*.tgz
/catpaw-cn/*.tar.gz
/catpaw-cn/*.tar.xz
/catpaw/*.zip
/catpaw/*.tgz
/catpaw/*.tar.gz
/catpaw/*.tar.xz

# gw2api-bin release downloads
/gw2api-bin/gemini-web2api-go_v*_linux_*

# workbuddy port downloads
/workbuddy-*/*.zip
/workbuddy-*/*.deb

# qoderwake release archives
/qoderwake-bin/*.tar.gz
/qoderwake-cn-bin/*.tar.gz

# python bytecode
__pycache__/
*.py[cod]

# 无扩展名的上游二进制（catpaw CLI / agent-browser）
/catpaw/catpaw-cli-linux-x64*
/catpaw-cn/catpaw-cli-linux-x64*
/catpaw-cn/agent-browser-linux-x64

# MiMo 官方 deb 下载
/mimo-desktop-bin/*.deb

# appclone 官方发布归档
/appclone-bin/*.tar.gz

# workbuddy-agent 上游 npm 预编译包
/workbuddy-agent/*.tgz

# qoder 客户端 RPM 下载
/qoder-agent/qoder-*.rpm
/qoder-cn-agent/qoder-cn-*.rpm
/qoder-ide/qoder-ide-*.rpm
/qoder-cn-ide/qoder-cn-ide-*.rpm

# trae-cn 官方归档下载
/trae-cn-ide/Trae_CN-linux-*.tar.gz

# minimax-code-bin / kimi-work-bin 上游下载
/minimax-code-bin/*.tgz
/minimax-code-bin/*.tar.gz

# kimi-code / kimi-work / minimax-code 国际版与国内版上游下载
/kimi-code-intl-bin/*.deb
/kimi-code-cn-bin/*.deb
/kimi-work-intl-bin/*.exe
/kimi-work-cn-bin/*.exe
/minimax-code-intl-bin/*.exe
/minimax-code-intl-bin/*.zip
/minimax-code-intl-bin/*.tgz
/minimax-code-intl-bin/*.tar.gz
/minimax-code-cn-bin/*.exe
/minimax-code-cn-bin/*.zip
/minimax-code-cn-bin/*.tgz
/minimax-code-cn-bin/*.tar.gz
