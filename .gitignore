# makepkg build products
pkg/
src/
*.pkg.tar.zst
*.pkg.tar.xz
*.pkg.tar.gz
*.pkg.tar.bz2
*.pkg.tar.lz4

# downloaded upstream archives must never be committed
*.part
*.dmg
*.exe
/catpaw/*innoextract-linux-amd64
/catpaw-cn/*innoextract-linux-amd64
/catpaw-cn/*.zip
/catpaw-cn/*.tgz
/catpaw-cn/*.tar.gz
/catpaw-cn/*.tar.xz
/catpaw/*.zip
/catpaw/*.tgz
/catpaw/*.tar.gz
/catpaw/*.tar.xz

# gw2api-bin release downloads
/gw2api-bin/gemini-web2api-go_v*-linux-*

# workbuddy port downloads
/workbuddy-*/*.zip
/workbuddy-*/*.deb

# qoderwake release archives
/qoderwake-bin/*.tar.gz
/qoderwake-cn-bin/*.tar.gz

# python bytecode
__pycache__/
*.py[cod]

# 无扩展名的上游二进制（catpaw CLI / agent-browser）
/catpaw/catpaw-cli-linux-x64*
/catpaw-cn/catpaw-cli-linux-x64*
/catpaw-cn/agent-browser-linux-x64

# MiMo 官方 deb 下载
/mimo-desktop-bin/*.deb

# qoder 客户端 RPM 下载
/qoder-agent/qoder-*.rpm
/qoder-cn-agent/qoder-cn-*.rpm

# trae-cn 官方归档下载
/trae-cn-ide/Trae_CN-linux-*.tar.gz
